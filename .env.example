# ==============================================================================
# Ayaka Secret Credentials Template (.env)
# ==============================================================================
# Copy this file to `.env` and fill in your private tokens and session cookies.
# DO NOT commit real secrets to Git or share them!
#
# NOTE: All operational settings (Gmail keywords, domains, polling intervals,
# URLs, and database paths) are located in `config.json`.
# All character voice lines and dialogue scenarios are in `dialogues.json`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DISCORD BOT SECRETS
# ------------------------------------------------------------------------------
# Bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Your personal Discord User ID (to receive private DM reminders)
DISCORD_USER_ID=

# ------------------------------------------------------------------------------
# 2. ACADEMIC PLATFORMS (SESSION COOKIES / TOKENS)
# ------------------------------------------------------------------------------
# Edunex ITB (https://edunex.itb.ac.id)
# Extract Cookie header or Bearer token from DevTools Network/Application tab
EDUNEX_COOKIE=
EDUNEX_BEARER_TOKEN=

# SIX ITB (https://six.itb.ac.id)
# Extract session cookie (typically ci_session=...) from Application > Cookies
SIX_COOKIE=

# Omnicampus (https://edu.omnicamp.us)
# Extract Bearer token or session cookie from DevTools Application/Storage
OMNICAMPUS_TOKEN=
OMNICAMPUS_COOKIE=

# ------------------------------------------------------------------------------
# 3. GOOGLE WORKSPACE CREDENTIALS (OPTIONAL OVERRIDES)
# ------------------------------------------------------------------------------
# Paths to your Google OAuth client secret and token files
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
